@@ -358,6 +359,65 @@ public class StoreKeeperHelper {
         return null;
     }
 
+    private void addRackStatesFromLocationMap(
+            Map<String, Rack> rackByNumber, Set<String> requestedRackNumbers, String buildingName) {
+        if (rackByNumber.isEmpty()) {
+            return;
+        }
+
+        String pageToken = null;
+        try {
+            do {
+                ListRackLocationsMapRequest request =
+                        ListRackLocationsMapRequest.builder()
+                                .buildingName(buildingName)
+                                .numResults(RACK_LIST_SIZE)
+                                .pageToken(pageToken)
+                                .build();
+
+                ListRackLocationsMapResponse response =
+                        this.storeKeeperClient.listRackLocationsMap(request);
+                if (response == null
+                        || response.getListRackLocationsMap() == null
+                        || response.getListRackLocationsMap().getRackLocations() == null) {
+                    log.warn(
+                            "Empty response from Storekeeper rack location map for buildingName={}; returning rack details without rack state",
+                            buildingName);
+                    return;
+                }
+
+                for (RackLocationMap rackLocationMap :
+                        response.getListRackLocationsMap().getRackLocations()) {
+                    if (rackLocationMap == null || rackLocationMap.getRackNumber() == null) {
+                        continue;
+                    }
+
+                    String returnedRackNumber = trimRackNumber(rackLocationMap.getRackNumber());
+                    if (!requestedRackNumbers.contains(returnedRackNumber)) {
+                        continue;
+                    }
+
+                    Rack rack = rackByNumber.get(returnedRackNumber);
+                    if (rack != null) {
+                        rack.setRackState(normalizedRackState(rackLocationMap.getRackState()));
+                    }
+                }
+
+                if (rackByNumber.values().stream().allMatch(rack -> rack.getRackState() != null)) {
+                    return;
+                }
+
+                pageToken = response.getListRackLocationsMap().getNextPageToken();
+            } while (pageToken != null);
+        } catch (Exception e) {
+            log.warn(
+                    "Failed fetching rack location map states for rackNumbers={} buildingName={}; returning rack details without rack state",
+                    requestedRackNumbers,
+                    buildingName,
+                    e);
+        }
+    }
+
     private static final class RackLookupResult {
         private final String rackNumber;
         private final Rack rack;
