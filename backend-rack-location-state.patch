From 5f89a48abab3631c266ea28d0fe25aa0523a1f10 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Mon, 1 Jun 2026 17:08:41 +0000
Subject: [PATCH] Return rack state in rack location details

---
 .../service/dependencies/storekeeper/StoreKeeperHelper.java   | 2 +-
 .../pic/networking/lvv/service/service/RacksService.java      | 1 +
 .../dependencies/storekeeper/StoreKeeperHelperTest.java       | 2 ++
 .../pic/networking/lvv/service/service/RacksServiceTest.java  | 4 ++++
 lvv-service-spec/src/specs/api.cond.yaml                      | 1 +
 5 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/lvv-service-api/src/main/java/com/oracle/pic/networking/lvv/service/dependencies/storekeeper/StoreKeeperHelper.java b/lvv-service-api/src/main/java/com/oracle/pic/networking/lvv/service/dependencies/storekeeper/StoreKeeperHelper.java
index 27b2e93..e812039 100644
--- a/lvv-service-api/src/main/java/com/oracle/pic/networking/lvv/service/dependencies/storekeeper/StoreKeeperHelper.java
+++ b/lvv-service-api/src/main/java/com/oracle/pic/networking/lvv/service/dependencies/storekeeper/StoreKeeperHelper.java
@@ -382,7 +382,7 @@ public class StoreKeeperHelper {
                 .block(rackLocation.getBlock() == null ? null : rackLocation.getBlock().getName())
                 .rackLocation(rackLocation.getRackNumber())
                 .rackSerial(rackLocation.getRackSerial())
-                .rackState(null)
+                .rackState(normalizedRackState(rackLocation.getRackState()))
                 .platformName(rackLocation.getPlatformName())
                 .isGpuRack(isGpuRack(rackLocation.getPlatformName()))
                 .build();
diff --git a/lvv-service-api/src/main/java/com/oracle/pic/networking/lvv/service/service/RacksService.java b/lvv-service-api/src/main/java/com/oracle/pic/networking/lvv/service/service/RacksService.java
index ccf27f1..d298d61 100644
--- a/lvv-service-api/src/main/java/com/oracle/pic/networking/lvv/service/service/RacksService.java
+++ b/lvv-service-api/src/main/java/com/oracle/pic/networking/lvv/service/service/RacksService.java
@@ -420,6 +420,7 @@ public class RacksService {
                             .rackSerialNumber(rack.getRackSerial())
                             .block(rack.getBlock())
                             .platformName(rack.getPlatformName())
+                            .rackState(rack.getRackState())
                             .build());
         }
 
diff --git a/lvv-service-api/src/test/java/com/oracle/pic/networking/lvv/service/dependencies/storekeeper/StoreKeeperHelperTest.java b/lvv-service-api/src/test/java/com/oracle/pic/networking/lvv/service/dependencies/storekeeper/StoreKeeperHelperTest.java
index 6ab0301..7531919 100644
--- a/lvv-service-api/src/test/java/com/oracle/pic/networking/lvv/service/dependencies/storekeeper/StoreKeeperHelperTest.java
+++ b/lvv-service-api/src/test/java/com/oracle/pic/networking/lvv/service/dependencies/storekeeper/StoreKeeperHelperTest.java
@@ -79,6 +79,7 @@ class StoreKeeperHelperTest {
         when(rackLocation.getRackNumber()).thenReturn(rackNumber);
         when(rackLocation.getRackSerial()).thenReturn(rackSerial);
         when(rackLocation.getPlatformName()).thenReturn("GPU-platform");
+        when(rackLocation.getRackState()).thenReturn("AVAILABLE");
         if (blockName != null) {
             Block block = mock(Block.class);
             when(block.getName()).thenReturn(blockName);
@@ -363,6 +364,7 @@ class StoreKeeperHelperTest {
         assertEquals("1001", result.get(0).getRackLocation());
         assertEquals("SL01", result.get(0).getRackSerial());
         assertEquals("1", result.get(0).getBlock());
+        assertEquals("IN-SERVICE", result.get(0).getRackState());
         assertEquals("1002", result.get(1).getRackLocation());
         assertEquals("SL02", result.get(1).getRackSerial());
         assertEquals("2", result.get(1).getBlock());
diff --git a/lvv-service-api/src/test/java/com/oracle/pic/networking/lvv/service/service/RacksServiceTest.java b/lvv-service-api/src/test/java/com/oracle/pic/networking/lvv/service/service/RacksServiceTest.java
index 26130f2..fca9ff3 100644
--- a/lvv-service-api/src/test/java/com/oracle/pic/networking/lvv/service/service/RacksServiceTest.java
+++ b/lvv-service-api/src/test/java/com/oracle/pic/networking/lvv/service/service/RacksServiceTest.java
@@ -1430,6 +1430,7 @@ class RacksServiceTest {
                         .block("1")
                         .rackLocation(rackNumber)
                         .rackSerial(rackSerial)
+                        .rackState("IN-SERVICE")
                         .platformName(rackPlatform)
                         .build();
 
@@ -1442,6 +1443,7 @@ class RacksServiceTest {
                         .block("2")
                         .rackLocation(rackNumber2)
                         .rackSerial(rackSerial2)
+                        .rackState("DELIVERED")
                         .platformName(rackPlatform2)
                         .build();
 
@@ -1463,12 +1465,14 @@ class RacksServiceTest {
         assertEquals("1", first.getBlock());
         assertEquals(rackSerial, first.getRackSerialNumber());
         assertEquals(rackPlatform, first.getPlatformName());
+        assertEquals("IN-SERVICE", first.getRackState());
 
         RackLocationDetail second = result.getRacks().get(1);
         assertEquals(rackNumber2, second.getRackNumber());
         assertEquals("2", second.getBlock());
         assertEquals(rackSerial2, second.getRackSerialNumber());
         assertEquals(rackPlatform2, second.getPlatformName());
+        assertEquals("DELIVERED", second.getRackState());
 
         verify(storeKeeperHelper)
                 .listRackLocationDetails(
diff --git a/lvv-service-spec/src/specs/api.cond.yaml b/lvv-service-spec/src/specs/api.cond.yaml
index a2d90fb..b4f8b7e 100644
--- a/lvv-service-spec/src/specs/api.cond.yaml
+++ b/lvv-service-spec/src/specs/api.cond.yaml
@@ -1627,6 +1627,7 @@ definitions:
       rackSerialNumber: { type: string }
       block: { type: string }
       platformName: { type: string }
+      rackState: { type: string }
 
   PutProjectRequest:
     description: A request to create or update a project
